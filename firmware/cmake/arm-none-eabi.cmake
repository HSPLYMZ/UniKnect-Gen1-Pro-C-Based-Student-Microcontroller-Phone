# ARM GNU Toolchain (in-project, see tools/README.md)
set(CMAKE_SYSTEM_NAME Generic)
set(CMAKE_SYSTEM_PROCESSOR arm)
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)

set(ARM_GCC_ROOT "$ENV{ARM_GCC_ROOT}" CACHE PATH "ARM GNU 13.3.rel1 installation root")
if(NOT ARM_GCC_ROOT)
  set(ARM_GCC_ROOT "${CMAKE_CURRENT_LIST_DIR}/../../tools/arm-gnu-toolchain")
endif()
set(TOOLCHAIN_ROOT "${ARM_GCC_ROOT}/bin")
if(NOT EXISTS "${TOOLCHAIN_ROOT}/arm-none-eabi-gcc.exe")
  message(FATAL_ERROR "arm-none-eabi-gcc not found at ${TOOLCHAIN_ROOT}. Run tools/setup_toolchain.py first.")
endif()

set(CMAKE_C_COMPILER   "${TOOLCHAIN_ROOT}/arm-none-eabi-gcc.exe")
set(CMAKE_ASM_COMPILER "${TOOLCHAIN_ROOT}/arm-none-eabi-gcc.exe")
set(CMAKE_CXX_COMPILER "${TOOLCHAIN_ROOT}/arm-none-eabi-g++.exe")
set(CMAKE_AR           "${TOOLCHAIN_ROOT}/arm-none-eabi-ar.exe")
set(CMAKE_OBJCOPY      "${TOOLCHAIN_ROOT}/arm-none-eabi-objcopy.exe")
set(CMAKE_OBJDUMP      "${TOOLCHAIN_ROOT}/arm-none-eabi-objdump.exe")
set(CMAKE_SIZE         "${TOOLCHAIN_ROOT}/arm-none-eabi-size.exe")
set(CMAKE_GDB          "${TOOLCHAIN_ROOT}/arm-none-eabi-gdb.exe")

set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
